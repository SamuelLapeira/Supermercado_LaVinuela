# Plantilla de variables para el entorno local. NO se sube a Git el fichero .env real.
# ./tools/dev-up.sh crea .env a partir de esta plantilla con contraseñas aleatorias.

# --- MySQL ---
DB_NAME=shop
DB_PORT=3306
MYSQL_ROOT_PASSWORD=cambia-esto
DB_MIGRATE_PASSWORD=cambia-esto
DB_APP_PASSWORD=cambia-esto
DB_RO_PASSWORD=cambia-esto

# --- Redis / Valkey ---
REDIS_PORT=6379

# --- Correo de desarrollo (Mailpit) ---
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Seguridad de la aplicación ---
# APP_CODE_PEPPER (clave secreta de los códigos de verificación) la genera ./tools/dev-up automáticamente.
# Nunca se escribe aquí ni se sube a Git.
